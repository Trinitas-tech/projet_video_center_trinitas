{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.edit'|trans }} - Vidéo Center{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center">
        <div class="card bg-black text-light" style="max-width: 600px; width: 100%;">
            <div class="card-body">
                <h1 class="h3 text-center mb-4">{{ 'profile.edit'|trans }}</h1>

                {{ form_start(form) }}
                    {{ form_row(form.firstname) }}
                    {{ form_row(form.lastname) }}
                    {{ form_row(form.imageFile) }}

                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-success">{{ 'action.save'|trans }}</button>
                        <a href="{{ path('app_profile') }}" class="btn btn-secondary">{{ 'action.back'|trans }}</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
