{% extends 'base.html.twig' %}

{% block title %}{{ 'profile.title'|trans }} - Vidéo Center{% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="card bg-black text-light">
                <div class="card-body text-center">
                    <img src="{{ user.imageName ? vich_uploader_asset(user, 'imageFile') : asset('images/default-profile.svg') }}"
                         alt="{{ 'profile.image_alt'|trans }}"
                         class="rounded-circle mb-3 border border-secondary"
                         style="width: 150px; height: 150px; object-fit: cover;">
                    <h1 class="h4">{{ user.firstname }} {{ user.lastname }}</h1>
                    <p class="text-secondary mb-1">{{ user.email }}</p>
                    <p class="small text-secondary">
                        {{ 'profile.member_since'|trans }} {{ user.createdAt|date('d/m/Y') }}
                    </p>
                    {% if user.isVerified %}
                        <span class="badge bg-success">{{ 'profile.verified'|trans }}</span>
                    {% else %}
                        <span class="badge bg-warning text-dark">{{ 'profile.not_verified'|trans }}</span>
                    {% endif %}
                    <div class="mt-3">
                        <a href="{{ path('app_profile_edit') }}" class="btn btn-primary btn-sm">{{ 'profile.edit'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <h2 class="h4 mb-3">{{ 'profile.my_videos'|trans }} ({{ user.videos|length }})</h2>
            <div class="row g-4">
                {% for video in user.videos %}
                    <div class="col-12 col-md-6">
                        {% include 'video/_card.html.twig' with {video: video} %}
                    </div>
                {% else %}
                    <p>{{ 'profile.no_videos'|trans }}</p>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
