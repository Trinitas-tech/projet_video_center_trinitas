<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Vidéo Center{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="text-light" style="background: content-box radial-gradient(crimson, skyblue); min-height: 100vh;">

        {# ===== NAVBAR ===== #}
        <nav class="navbar navbar-expand-lg navbar-dark bg-black">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_home') }}">Vidéo Center</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_home') }}">{{ 'nav.home'|trans }}</a>
                        </li>
                        {% if app.user and app.user.isVerified %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_video_create') }}">{{ 'nav.create_video'|trans }}</a>
                            </li>
                        {% endif %}
                    </ul>

                    {% if app.user %}
                        <form class="d-flex me-3" method="get" action="{{ path('app_video_search') }}" role="search">
                            <input class="form-control form-control-sm me-2" type="search" name="q"
                                   placeholder="{{ 'nav.search_placeholder'|trans }}"
                                   value="{{ app.request.query.get('q') }}">
                            <button class="btn btn-outline-light btn-sm" type="submit">{{ 'nav.search'|trans }}</button>
                        </form>
                    {% endif %}

                    <ul class="navbar-nav">
                        {% if app.user %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_profile') }}">{{ 'nav.profile'|trans }}</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}">{{ 'nav.logout'|trans }}</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_register') }}">{{ 'nav.register'|trans }}</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                            </li>
                        {% endif %}
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.locale == 'fr' ? 'fw-bold text-decoration-underline' }}"
                               href="{{ path('app_change_locale', {locale: 'fr'}) }}">FR</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.locale == 'en' ? 'fw-bold text-decoration-underline' }}"
                               href="{{ path('app_change_locale', {locale: 'en'}) }}">EN</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        {# ===== MESSAGES FLASH ===== #}
        <div class="container mt-3">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'info' ? 'primary' : 'danger') }} text-center">
                        {{ message|trans }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {# ===== CONTENU ===== #}
        <main class="container-fluid my-4 px-4">
            {% block body %}{% endblock %}
        </main>

        {# ===== FOOTER ===== #}
        <footer class="bg-black text-center text-light py-3 mt-5">
            <div class="container">
                <a href="{{ path('app_home') }}" class="text-light text-decoration-none mx-2">{{ 'nav.home'|trans }}</a>
                {% if app.user and app.user.isVerified %}
                    <a href="{{ path('app_video_create') }}" class="text-light text-decoration-none mx-2">{{ 'nav.create_video'|trans }}</a>
                {% endif %}
                <p class="mb-0 mt-2 small">© {{ 'now'|date('Y') }} Vidéo Center — Trinitas</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
