{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center">
        <div class="card bg-black text-light" style="max-width: 500px; width: 100%;">
            <div class="card-body">
                <h1 class="h3 text-center mb-4">{{ 'reset.title'|trans }}</h1>

                <p>{{ 'reset.intro'|trans }}</p>

                {{ form_start(requestForm) }}
                    {{ form_row(requestForm.email) }}

                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-primary">{{ 'reset.submit'|trans }}</button>
                        <a href="{{ path('app_login') }}" class="btn btn-secondary">{{ 'action.back'|trans }}</a>
                    </div>
                {{ form_end(requestForm) }}
            </div>
        </div>
    </div>
{% endblock %}
