{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.new_password.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center">
        <div class="card bg-black text-light" style="max-width: 500px; width: 100%;">
            <div class="card-body">
                <h1 class="h3 text-center mb-4">{{ 'reset.new_password.title'|trans }}</h1>

                {{ form_start(resetForm) }}
                    {{ form_row(resetForm.plainPassword.first) }}
                    {{ form_row(resetForm.plainPassword.second) }}

                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-primary">{{ 'reset.new_password.submit'|trans }}</button>
                    </div>
                {{ form_end(resetForm) }}
            </div>
        </div>
    </div>
{% endblock %}
