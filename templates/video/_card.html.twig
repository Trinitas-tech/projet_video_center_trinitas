<div class="card bg-black text-light h-100">
    <div class="card-body text-center">
        {% if video.premiumVideo %}
            <span class="badge bg-warning text-dark mb-2">{{ 'video.premium'|trans }}</span>
        {% endif %}

        {# Miniature 300x200 cliquable : l'image est visible immédiatement,
           le lecteur se trouve sur la page de détail #}
        {% set thumbnail = video.videoLink|youtube_thumbnail %}
        {% if thumbnail %}
            <a href="{{ path('app_video_show', {id: video.id}) }}">
                <img src="{{ thumbnail }}" alt="{{ video.title }}"
                     width="300" height="200" loading="lazy"
                     class="rounded" style="object-fit: cover; max-width: 100%;">
            </a>
        {% else %}
            <iframe width="300" height="200" style="max-width: 100%;"
                    src="{{ video.videoLink|embed }}"
                    allowfullscreen></iframe>
        {% endif %}

        <h5 class="card-title mt-2">
            <a href="{{ path('app_video_show', {id: video.id}) }}"
               class="text-light text-decoration-none">
                {{ video.title|u.truncate(20, '...') }}
            </a>
        </h5>
        <p class="card-text text-secondary">
            {{ video.description|u.truncate(25, '...') }}
        </p>
        <p class="small text-secondary mb-0">
            {{ 'video.posted'|trans }} {{ video.createdAt|ago }}
            {{ 'video.by'|trans }} {{ video.user.firstname }} {{ video.user.lastname }}
        </p>
    </div>
</div>
