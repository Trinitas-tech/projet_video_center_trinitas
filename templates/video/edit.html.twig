{% extends 'base.html.twig' %}

{% block title %}{{ 'video.edit.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center">
        <div class="card bg-black text-light" style="max-width: 600px; width: 100%;">
            <div class="card-body">
                <h1 class="h3 text-center mb-4">{{ 'video.edit.title'|trans }}</h1>

                {{ form_start(form) }}
                    {{ form_row(form.title) }}
                    {{ form_row(form.videoLink) }}
                    {{ form_row(form.description) }}
                    {{ form_row(form.premiumVideo) }}

                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-success">{{ 'action.save'|trans }}</button>
                        <a href="{{ path('app_home') }}" class="btn btn-secondary">{{ 'action.back'|trans }}</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
