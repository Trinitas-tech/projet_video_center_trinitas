{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }} - Vidéo Center{% endblock %}

{% block body %}
    <div class="text-center mb-4">
        <h1>{{ 'home.welcome'|trans }}</h1>
        <p class="text-secondary">{{ 'home.subtitle'|trans }}</p>
    </div>

    <div class="row g-4">
        {% for video in videos %}
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 col-xxl-2">
                {% include 'video/_card.html.twig' with {video: video} %}
            </div>
        {% else %}
            <p class="text-center">{{ 'home.no_videos'|trans }}</p>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(videos) }}
    </div>
{% endblock %}
