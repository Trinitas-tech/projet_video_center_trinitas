{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center">
        <div class="card bg-black text-light" style="max-width: 500px; width: 100%;">
            <div class="card-body">
                <h1 class="h3 text-center mb-4">{{ 'login.title'|trans }}</h1>

                {% if error %}
                    <div class="alert alert-danger text-center">
                        {{ 'login.error'|trans }}
                    </div>
                {% endif %}

                <form method="post">
                    <div class="mb-3">
                        <label for="username" class="form-label">{{ 'form.email'|trans }}</label>
                        <input type="email" value="{{ last_username }}" name="_username"
                               id="username" class="form-control" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">{{ 'form.password'|trans }}</label>
                        <input type="password" name="_password" id="password"
                               class="form-control" required>
                    </div>

                    <div class="mb-2">
                        <a href="{{ path('app_forgot_password_request') }}">{{ 'login.forgot_password'|trans }}</a>
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input">
                        <label for="remember_me" class="form-check-label">{{ 'login.remember_me'|trans }}</label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-primary">{{ 'login.submit'|trans }}</button>

                    <p class="mt-3 small">
                        {{ 'login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'login.create_account'|trans }}</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
