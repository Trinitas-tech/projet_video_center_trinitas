{% extends 'base.html.twig' %}

{% block title %}{{ 'registration.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center">
        <div class="card bg-black text-light" style="max-width: 500px; width: 100%;">
            <div class="card-body">
                <h1 class="h3 text-center mb-4">{{ 'registration.title'|trans }}</h1>

                {{ form_start(form) }}
                    {{ form_row(form.firstname) }}
                    {{ form_row(form.lastname) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.plainPassword.first) }}
                    {{ form_row(form.plainPassword.second) }}

                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-primary">{{ 'registration.submit'|trans }}</button>
                    </div>

                    <p class="mt-3 small text-center">
                        {{ 'registration.already_account'|trans }} <a href="{{ path('app_login') }}">{{ 'nav.login'|trans }}</a>
                    </p>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
